# Учётные данные инфраструктуры для стека Core.
#
# Скопировать в deploy/.env НА ЦЕЛЕВОЙ МАШИНЕ и заполнить реальными значениями.
# deploy/.env в git не попадает (см. deploy/.gitignore) и не копируется скриптом
# deploy_all_stage.sh — он создаётся на сервере один раз, вручную или из CI-секретов.
#
# Здесь только ПЛЕЙСХОЛДЕРЫ. Реальные пароли в этот файл не вписывать.
#
# Локальный стенд (start_local.sh) работать без .env: dev-значения зашиты
# в docker-compose.infra.local.yml / docker-compose.management.local.yml.
# Если .env всё же лежит рядом, его значения перебивают локальные dev-значения.

# --- PostgreSQL ---------------------------------------------------------------
# ВНИМАНИЕ: официальный образ postgres создаёт пользователя только при ПЕРВОМ
# запуске на пустом томе. Если том postgres_data на сервере уже существует,
# укажите здесь те значения, с которыми он был инициализирован; чтобы сменить
# пароль по-настоящему — смените его в самой БД (ALTER USER) или пересоздайте том.
#
# Пароль подставляется в строку подключения Npgsql (docker-compose.app.stage.yml),
# поэтому не используйте в нём `;`, `'` и `"`.
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- NATS ---------------------------------------------------------------------
# Шина требует аутентификации (deploy/nats/nats-server.conf).
# Эти же значения должны попасть в .NET-сервисы: docker-compose.app.stage.yml
# передаёт их как NatsUser / NatsPassword.
NATS_USER=
NATS_PASSWORD=

# --- MinIO --------------------------------------------------------------------
# Логин/пароль корневого пользователя объектного хранилища. Gateway получает их
# как Minio__AccessKey / Minio__SecretKey (docker-compose.app.stage.yml).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Traefik ------------------------------------------------------------------
# DEBUG в логах роутера светит заголовки и маршруты — на stage только INFO/WARN/ERROR.
TRAEFIK_LOG_LEVEL=INFO

# --- Дашборд Traefik (опционально) -------------------------------------------
# Нужны ТОЛЬКО если стек поднимается вместе с docker-compose.infra.dashboard.yml.
# Хеш пароля генерируется так (вставить вывод целиком, без кавычек):
#   htpasswd -nbB admin '<пароль>'
TRAEFIK_DASHBOARD_HOST=
TRAEFIK_DASHBOARD_AUTH=
